#
# Event definitions for Spicy-based HTTP analyzer

protocol analyzer spicy::HTTP over TCP:
    parse originator with HTTP::Requests,
    parse responder with HTTP::Replies;

import HTTP;

# Map HTTP request line to http_request event
# Event signature: event http_request(c: connection, method: string, original_URI: string, unescaped_URI: string, version: string);
on HTTP::RequestLine -> event http_request(
    $conn,
    self.method,
    self.uri,
    self.uri,  # TODO: Implement URI unescaping
    self.version_string
);

# Map HTTP reply line to http_reply event
# Event signature: event http_reply(c: connection, version: string, code: count, reason: string);
on HTTP::ReplyLine -> event http_reply(
    $conn,
    "%d.%d" % (self.version.major, self.version.minor),
    self.code,
    self.reason
);

