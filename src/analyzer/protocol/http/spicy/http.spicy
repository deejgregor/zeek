#
# Spicy-based HTTP protocol analyzer
# This is a minimal initial implementation for testing

module HTTP;

import spicy;
# import zeek;  # Only available when building with Zeek

# Common patterns
const Token      = /[^ \t\r\n]+/;
const WhiteSpace = /[ \t]+/;
const NewLine    = /\r?\n/;
const OptWS      = /[ \t]*/;

# HTTP version: HTTP/x.y
type Version = unit {
    : /HTTP\//;
    major: /[0-9]+/ &convert=$$.to_uint();
    : /\./;
    minor: /[0-9]+/ &convert=$$.to_uint();

    on %done {
        # Store version as string for event
    }
};

# HTTP request line: METHOD URI HTTP/VERSION or METHOD URI (for HTTP/0.9)
public type RequestLine = unit {
    method:  Token;
    :        WhiteSpace;
    uri:     Token;

    # Optional whitespace and version (HTTP/1.x)
    # For HTTP/0.9, the line ends after URI
    # We'll parse the rest as bytes and check for version
    rest: bytes &until=b"\n";

    var version_string: string = "0.9";
    var has_version: bool = False;

    on rest {
        # Check if rest contains "HTTP/" to determine if version is present
        local found = self.rest.find(b"HTTP/");
        if ( found[0] ) {  # found is tuple<bool, iterator>, use first element
            self.has_version = True;
            # TODO: Parse actual version number from self.rest
            self.version_string = "1.1";  # Temporary default
        }
    }

    on %done {
        print "HTTP Request:", self.method, self.uri, "version:", self.version_string;
    }
};

# HTTP response/reply line: HTTP/VERSION CODE REASON
public type ReplyLine = unit {
    version: Version;
    :        WhiteSpace;
    code:    /[0-9]{3}/ &convert=$$.to_uint();
    :        WhiteSpace;
    reason:  /[^\r\n]*/;
    :        NewLine;

    on %done {
        print "HTTP Reply:", self.code, self.reason;
    }
};

# HTTP header: Name: Value
# Commented out for now - will re-enable after basic parsing works
# type Header = unit {
