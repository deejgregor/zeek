#
# Spicy-based HTTP protocol analyzer
# This is a minimal initial implementation for testing

module HTTP;

import spicy;
import zeek;

# Common patterns
const Token      = /[^ \t\r\n]+/;
const WhiteSpace = /[ \t]+/;
const NewLine    = /\r?\n/;
const OptWS      = /[ \t]*/;

# HTTP version: HTTP/x.y
type Version = unit {
    : /HTTP\//;
    major: /[0-9]+/ &convert=$$.to_uint();
    : /\./;
    minor: /[0-9]+/ &convert=$$.to_uint();

    on %done {
        # Store version as string for event
    }
};

# HTTP request line: METHOD URI HTTP/VERSION or METHOD URI (for HTTP/0.9)
public type RequestLine = unit {
    method:  Token;
    :        WhiteSpace;
    uri:     Token;

    # Optional whitespace and version (HTTP/1.x)
    # For HTTP/0.9, the line ends after URI
    # We'll use a switch to handle both cases
    switch {
        -> has_version: WhiteSpace Version NewLine;
        -> no_version:  NewLine;
    };

    on %done {
        print "HTTP Request:", self.method, self.uri;
    }
};

# HTTP response/reply line: HTTP/VERSION CODE REASON
public type ReplyLine = unit {
    version: Version;
    :        WhiteSpace;
    code:    /[0-9]{3}/ &convert=$$.to_uint();
    :        WhiteSpace;
    reason:  /[^\r\n]*/;
    :        NewLine;

    on %done {
        print "HTTP Reply:", self.code, self.reason;
    }
};

# HTTP header: Name: Value
type Header = unit {
    name:  /[^:\r\n]+/;
    :      /:/;
    :      OptWS;
    value: /[^\r\n]*/;
    :      NewLine;

    on %done {
        print "HTTP Header:", self.name, "=", self.value;
    }
};

# Collection of headers (until blank line)
type Headers = unit {
    # Parse headers until we see a line that's just newline
    :       Header[] &until(self.at_end);
    :       NewLine;  # The blank line ending headers

    var at_end: bool = False;

    # TODO: Detect blank line properly
    # For now, this is a placeholder
};

# HTTP request message
public type Request = unit {
    request: RequestLine;
    # headers:  Headers;  # TODO: Add headers back
    # Body parsing will come later

    on %done {
        spicy::accept_input();
    }
};

# HTTP response message
public type Reply = unit {
    reply: ReplyLine;
    # headers: Headers;  # TODO: Add headers back
    # Body parsing will come later

    on %done {
        spicy::accept_input();
    }
};

# Stream of HTTP requests (client->server)
public type Requests = unit {
    : Request[];
};

# Stream of HTTP replies (server->client)
public type Replies = unit {
    : Reply[];
};
