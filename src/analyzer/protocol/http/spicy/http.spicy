# HTTP request message
public type Request = unit {
    request: RequestLine;
    # headers:  Headers;  # TODO: Add headers back
    # Body parsing will come later

    on %done {
        spicy::accept_input();
    }
};

# HTTP response message
public type Reply = unit {
    reply: ReplyLine;
    # headers: Headers;  # TODO: Add headers back
    # Body parsing will come later

    on %done {
        spicy::accept_input();
    }
};

# Stream of HTTP requests (client->server)
public type Requests = unit {
    : Request[];
};

# Stream of HTTP replies (server->client)
public type Replies = unit {
    : Reply[];
};
