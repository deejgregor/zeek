# See the file "COPYING" in the main distribution directory for copyright.
#
# Spicy-based HTTP protocol analyzer
# This is a work-in-progress migration from the C++ HTTP analyzer

module HTTP;

import spicy;
import zeek;

# HTTP version parsing
type Version = unit {
    : /HTTP\//;
    major: /[0-9]+/ &convert=$$.to_uint();
    : /\./;
    minor: /[0-9]+/ &convert=$$.to_uint();

    var version_string: string;

    on %done {
        self.version_string = "%d.%d" % (self.major, self.minor);
    }
};

# HTTP request line: METHOD URI [VERSION]
# HTTP/0.9 has no version, HTTP/1.x includes "HTTP/x.y"
public type RequestLine = unit {
    # Method token (e.g., GET, POST, PUT, etc.)
    method: /[^ \t\r\n]+/;
    : /[ \t]+/;

    # URI (original, with potential percent-encoding)
    uri: /[^ \t\r\n]+/;

    # Rest of line - either " HTTP/x.y\r?\n" or just "\r?\n" for HTTP/0.9
    rest_of_line: bytes &until=b"\n";

    var version_string: string = "0.9";
    var has_version: bool = False;

    on rest_of_line {
        # Parse the rest of line to extract version if present
        local rest = self.rest_of_line;

        # Check if it starts with whitespace + "HTTP/"
        # For simplicity, just check if line contains "HTTP/"
        if ( rest.find(b"HTTP/") )
            self.has_version = True;

        # TODO: Actually parse the version from rest_of_line
        # For now, just assume HTTP/1.1 if version present
        if ( self.has_version )
            self.version_string = "1.1";
    }
};

# HTTP reply/response line: VERSION CODE REASON
public type ReplyLine = unit {
    version: Version;
    : /[ \t]+/;

    # Status code (3 digits)
    code: /[0-9]{3}/ &convert=$$.to_uint();
    : /[ \t]+/;

    # Reason phrase (rest of line)
    reason: /[^\r\n]*/;
    : /\r?\n/;
};

# HTTP header field
type Header = unit {
    # Header name (token up to colon)
    name: /[^:\r\n]+/;
    : /:/;
    : /[ \t]*/;  # Optional whitespace after colon

    # Header value (rest of line, may span multiple lines with folding)
    value: /[^\r\n]*/;
    : /\r?\n/;

    # TODO: Handle header folding (continuation lines starting with space/tab)
};

# Collection of headers - parse until we hit a blank line
type Headers = unit {
    headers: Header[] &until(self.done);
    : /\r?\n/;  # Empty line marks end of headers

    var done: bool = False;

    # Note: This is simplified - proper implementation would check for
    # blank line (\r\n\r\n or \n\n) during parsing
};

# HTTP message body
# This is simplified - real implementation needs to handle:
# - Content-Length
# - Transfer-Encoding: chunked
# - Connection: close (read until EOF)
type Body = unit {
    # TODO: Implement body parsing based on headers
    # For now, just capture as bytes
    data: bytes &eod;
};

# Complete HTTP request
public type Request = unit {
    request_line: RequestLine;
    headers: Headers;
    # body: Body;  # TODO: Add conditional body parsing

    on %done {
        # Accept this as valid HTTP input
        spicy::accept_input();
    }
};

# Complete HTTP reply/response
public type Reply = unit {
    reply_line: ReplyLine;
    headers: Headers;
    # body: Body;  # TODO: Add conditional body parsing

    on %done {
        # Accept this as valid HTTP input
        spicy::accept_input();
    }
};

# Top-level unit for parsing HTTP requests (from client)
public type Requests = unit {
    : Request[];
};

# Top-level unit for parsing HTTP replies (from server)
public type Replies = unit {
    : Reply[];
};
